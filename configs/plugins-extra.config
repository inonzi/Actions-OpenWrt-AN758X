# ================================================================
# plugins-extra.config —— 定制插件开关片段（10 项）
# 用法：由 workflow 在加载机型 config 之后 cat 追加到 .config，
#       再统一 make defconfig 展开。不改动原版任何 configs/*.config。
#
# 依赖来源说明：
#   - sing-box / curl / kmod-tun / ip-full / etherwake / ttyd 等本体：feeds 现成
#   - luci-app-momo：第三方，由 diy-part1-custom.sh clone
#   - tailscale / owq-wol / fluent：原版 diy-part1.sh 已 clone（本机继承）
# ================================================================
# --- 1. Momo 透明代理（sing-box，前端由 diy clone；sing-box 用 feeds 1.14.x） ---
CONFIG_PACKAGE_luci-app-momo=y
CONFIG_PACKAGE_momo=y
CONFIG_PACKAGE_luci-i18n-momo-zh-cn=y
CONFIG_PACKAGE_sing-box=y
# --- 2. Tailscale（前端 asvow 由 diy clone；本体用 feeds tailscale） ---
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_tailscale=y
# --- 2b. rtp2httpd 升级到官方 v3.17.2 + 新版 JS 界面 [定制追加] ---
# 主程序与 LuCI 界面包在 diy 阶段已用 stackia 官方源码就地覆盖 feeds 旧包；
# 这里用开关控制安装。注意机型默认 config 里也有 luci-app-rtp2httpd=y（旧版遗留），
# 两处 =y 不冲突，最终以覆盖后的官方源码为准。
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
# 新版 JS 界面自带多语言，官方包未单独提供 luci-i18n-rtp2httpd-zh-cn；
# 若 feeds 里恰好有该包则自动装上，没有也不影响编译（defconfig 静默剔除）。
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y
# --- 3+4. WireGuard 完整支持 + 状态显示（全部 feeds 现成） ---
# luci-proto-wireguard 会自动带出 kmod-wireguard / wireguard-tools 依赖，
# 这里把关键依赖显式列出，确保 defconfig 后一定在位。
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_rpcd-mod-wireguard=y
CONFIG_PACKAGE_resolveip=y
# --- 5. UPnP（feeds 现成） ---
CONFIG_PACKAGE_luci-app-upnp=y
# --- 6. 网络唤醒 WOL（前端 isalikai 由 diy clone；依赖 feeds etherwake） ---
CONFIG_PACKAGE_luci-app-owq-wol=y
CONFIG_PACKAGE_etherwake=y
# --- 7. Fluent 主题（LazuliKao 由原版 diy clone） ---
CONFIG_PACKAGE_luci-theme-fluent=y
# --- 8/9/10. 常用命令行工具（feeds 现成） ---
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ttyd=y
# --- 10b. ttyd 网页终端界面 + 简体中文 [本次新增] ---
# 只开 ttyd=y 只有命令行本体，LuCI 菜单入口由 luci-app-ttyd 提供；
# luci-app-ttyd 的 Makefile 依赖 +ttyd（已有），不会重复。中文包来自 po/zh_Hans。
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
